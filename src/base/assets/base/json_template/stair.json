{
    "id": "base:stair",

    "parameters": {
        "texture": "string",
        "id": "string",
        "sound_events": "string"
    },
    "json": {
        "id": "${id}",

        "states": {
            "#default": {
                "model": {
                    "include": "base:stair",
                    "textures": {
                        "block": "${texture}"
                    }
                },
                "events": {
                    "include": [ "base:placement/stair", "${sound_events}" ],

                    "triggers": {
                        "relay_drop": {
                            "if": { "player": { "infiniteItems": false } },
                            "then": {
                                "id": "base:drop_item",
                                "args": {
                                    "stack": "${id}[direction=west,half=bottom]"
                                }
                            }
                        },
                        "base:destroy": "self#relay_drop",
                        "base:explode": "self#relay_drop"
                    }
                },
                "collider": {
                    "hitboxes": [
                        { "from": [ 0, 0, 0 ], "to": [ 1, 0.5, 1 ] },
                        { "from": [ 0, 0.5, 0.5 ], "to": [ 1, 1, 1 ] }
                    ]
                },
                "tags": [ "hidden" ],
                "pickBlockState": "direction=west,half=bottom"
            },


            "direction=south,half=bottom": {
                "parent": "#default"
            },
            "direction=west,half=bottom": {
                "parent": "#default",
                "transforms": { "rotateY": { "angle": 1, "transformUVs": true } },
                "tags": [ "^hidden" ]
            },
            "direction=north,half=bottom": {
                "parent": "#default",
                "transforms": { "rotateY": { "angle": 2, "transformUVs": true } }
            },
            "direction=east,half=bottom": {
                "parent": "#default",
                "transforms": { "rotateY": { "angle": 3, "transformUVs": true } }
            },

            "direction=south,half=top": {
                "parent": "#default",
                "transforms": { "rotateZ": { "angle": 2, "transformUVs": true } }
            },
            "direction=west,half=top": {
                "parent": "#default",
                "transforms": {
                    "rotateZ": { "angle": 2, "transformUVs": true },
                    "rotateY": { "angle": 1, "transformUVs": true }
                }
            },
            "direction=north,half=top": {
                "parent": "#default",
                "transforms": {
                    "rotateZ": { "angle": 2, "transformUVs": true },
                    "rotateY": { "angle": 2, "transformUVs": true }
                }
            },
            "direction=east,half=top": {
                "parent": "#default",
                "transforms": {
                    "rotateZ": { "angle": 2, "transformUVs": true },
                    "rotateY": { "angle": 3, "transformUVs": true }
                }
            }
        }
    }
}