{
    "id": "base:furnace",
    "tickable": true,

    "slots": [
        // ingredient
        {
            "onInsert": "wake",
            "onExtract": "check_recipe"
        },
        // fuel
        {
            "onInsert": "wake"
        },
        // output
        {
            "insert": false,
            "onExtract": "wake"
        }
    ],
    "data": {
        "cook_time": {
            "type": "number",
            "default": -1
        },
        "fuel_time": {
            "type": "number",
            "default": 0
        }
    }
}