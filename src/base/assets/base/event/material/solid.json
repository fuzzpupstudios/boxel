{
    "id": "base:material/solid",

    "triggers": {
        "base:place": [
            {
                "base:play_sound": {
                    "spatial": true,
                    "sound": {
                        "name": "base:block/place/solid",
                        "pitch": [ 0.95, 1 ]
                    }
                }
            }
        ],
        "base:destroy": [
            {
                "base:play_sound": {
                    "spatial": true,
                    "sound": {
                        "name": "base:block/destroy/solid",
                        "pitch": [ 0.95, 1 ]
                    }
                }
            }
        ],
        "base:step": [
            {
                "if": { "usages": { "used": false } },
                "then": {
                    "base:play_sound": {
                        "spatial": true,
                        "useEntityPosition": true,
                        "sound": {
                            "name": "base:block/place/solid",
                            "pitch": [ 1.3, 1.35 ],
                            "volume": 0.5
                        }
                    }
                }
            }
        ],
        "base:hit": [
            {
                "base:play_sound": {
                    "spatial": true,
                    "useHitPosition": true,
                    "sound": {
                        "name": "base:block/place/solid",
                        "pitch": [ 1.3, 1.35 ],
                        "volume": 0.5
                    }
                }
            }
        ],
        "base:fall": [
            {
                "if": { "usages": { "used": false } },
                "then": {
                    "base:play_sound": {
                        "spatial": true,
                        "useEntityPosition": true,
                        "sound": {
                            "name": "base:block/place/solid",
                            "pitch": [ 1.2, 1.25 ],
                            "volume": 1
                        }
                    }
                }
            }
        ]
    }
}