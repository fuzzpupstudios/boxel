{
    "id": "base:block/door_top",

    "include": "base:block/door_common",
    
    "triggers": {
        "base:destroy": [
            {
                "if": {
                    "block": {
                        "at": [ 0, -1, 0 ],
                        "has_tag": "base:door"
                    }
                },
                "then": { "base:set_block_state_id": {
                    "yOffset": -1,
                    "blockStateId": "base:air[default]",
                    "showParticles": true
                } }
            }
        ],
        "base:explode": "self#base:destroy",
        "base:interact": [
            {
                "if": {
                    "block": {
                        "has_tag": "base:door/open"
                    }
                },
                "then": [
                    "self#door_close_relay",
                    { "base:run_trigger": {
                        "triggerName": "door_close_relay",
                        "yOffset": -1
                    } }
                ],
                "else": [
                    "self#door_open_relay",
                    { "base:run_trigger": {
                        "triggerName": "door_open_relay",
                        "yOffset": -1
                    } }
                ]
            },
            {
                "id": "base:prevent_default"
            }
        ]
    }
}