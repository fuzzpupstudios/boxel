{
    "id": "base:block/door_bottom",

    "include": "base:block/door_common",
    
    "triggers": {
        "base:destroy": [
            {
                "if": { "block": {
                    "at": [ 0, 1, 0 ],
                    "has_tag": "base:door"
                } },
                "then": { "base:set_block_state_id": {
                    "yOffset": 1,
                    "blockStateId": "base:air[default]",
                    "showParticles": true
                } }
            }
        ],
        "base:explode": "self#base:destroy",
        "base:place": [
            {
                "if": {
                    "entity": {
                        "minYaw": -45,
                        "maxYaw": 45
                    }
                },
                "then": { "base:set_block_state_parameter": {
                    "parameters": {
                        "direction": "north"
                    }
                } }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 45,
                        "maxYaw": 135
                    }
                },
                "then": { "base:set_block_state_parameter": {
                    "parameters": {
                        "direction": "east"
                    }
                } }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 135,
                        "maxYaw": -135
                    }
                },
                "then": { "base:set_block_state_parameter": {
                    "parameters": {
                        "direction": "south"
                    }
                } }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": -135,
                        "maxYaw": -45
                    }
                },
                "then": { "base:set_block_state_parameter": {
                    "parameters": {
                        "direction": "west"
                    }
                } }
            },
            { "base:clone_block": {
                "to": [ 0, 1, 0 ]
            } },
            { "base:set_block_state_parameter": {
                "yOffset": 1,
                "parameters": {
                    "half": "top"
                }
            } }
        ],
        "base:interact": [
            {
                "if": { "block": {
                    "has_tag": "base:door/open"
                } },
                "then": [
                    "self#door_close_relay",
                    { "base:run_trigger": {
                        "triggerName": "door_close_relay",
                        "yOffset": 1
                    } }
                ],
                "else": [
                    "self#door_open_relay",
                    { "base:run_trigger": {
                        "triggerName": "door_open_relay",
                        "yOffset": 1
                    } }
                ]
            },
            {
                "id": "base:prevent_default"
            }
        ]
    }
}