{
    "id": "base:block/drop_self",
    
    "triggers": {
        "base:destroy": {
            "if": { "player": { "infiniteItems": false } },
            "then": { "id": "base:drop_block_item" }
        },
        "base:explode": {
            "if": { "player": { "infiniteItems": false } },
            "then": { "id": "base:drop_block_item" }
        }
    }
}