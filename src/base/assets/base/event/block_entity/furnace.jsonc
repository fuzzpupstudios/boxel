{
    "id": "base:block_entity/furnace",
    
    "triggers": {
        "base:block_entity/tick": {
            "if": {
                "block": { "params": { "lit": "true" } }
            },
            "then": "self#update"
        },
        "wake": [
            {
                "if": {
                    "block": { "params": { "lit": "false" } }
                },
                "then": "self#update"
            }
        ],
        "update": [
            {
                "base:assign_value": {
                    "name": "input_slot",
                    "ref": { "slot": {
                        "block_entity": [ 0, 0, 0 ],
                        "slot": 0
                    } }
                }
            },
            {
                "if": {
                    "greater_than": [
                        { "block_entity_data": "fuel_time" },
                        0
                    ]
                },
                "then": "self#burn",
                "else": [
                    "self#get_recipe",
                    {
                        "if": { "variable_exists": "recipe" },
                        "then": [
                            "self#try_burn_fuel",
                            {
                                "if": { "boolean_set": "burn_fuel_success" },
                                "then": [
                                    { "base:set_block_state_parameter": {
                                        "parameters": { "lit": "true" }
                                    } },
                                    "self#burn"
                                ],
                                "else": "self#sleep"
                            }
                        ],
                        "else": "self#sleep"
                    }
                ]
            }
        ],
        "burn": [
            { "base:set_block_entity_data": {
                "data": {
                    "fuel_time": { "sum": [
                        { "block_entity_data": "fuel_time" },
                        -1
                    ] }
                }
            } },
            {
                "if": {
                    "greater_than": [
                        { "block_entity_data": "cook_time" },
                        0
                    ]
                },
                "then": { "base:set_block_entity_data": {
                    "data": {
                        "cook_time": { "sum": [
                            { "block_entity_data": "cook_time" },
                            -1
                        ] }
                    } }
                },
                "else": {
                    "if": {
                        "equal": [
                            { "block_entity_data": "cook_time" },
                            0
                        ]
                    },
                    "then": [
                        "self#try_cook_input",
                        {
                            "if": { "boolean_set": "cook_input_success" },
                            "then": "self#try_start_cooking",
                            "else": { "base:set_block_entity_data": {
                                "data": {
                                    "cook_time": -1
                                }
                            } }
                        }
                    ],
                    "else": "self#try_start_cooking"
                }
            }
        ],
        "sleep": [
            { "base:set_block_state_parameter": {
                "parameters": {
                    "lit": "false"
                }
            } },
            { "base:set_block_entity_data": {
                "data": {
                    "cook_time": -1
                }
            } }
        ],
        "check_recipe": [
            { "base:assign_value": {
                "name": "input_slot",
                "ref": { "slot": {
                    "block_entity": [ 0, 0, 0 ],
                    "slot": 0
                } }
            } },
            "self#get_recipe",
            {
                "if": { "not": { "variable_exists": "recipe" } },
                "then": { "base:set_block_entity_data": {
                    "data": {
                        "cook_time": -1
                    }
                } }
            }
        ],
        "try_start_cooking": [
            "self#get_recipe",
            {
                "if": { "variable_exists": "recipe" },
                "then": { "base:set_block_entity_data": {
                    "data": {
                        "cook_time": 50
                    }
                } }
            }
        ],
        "try_cook_input": [
            { "base:assign_value": {
                "name": "cook_input_success",
                "value": false
            } },
            "self#get_recipe",
            {
                "if": { "variable_exists": "recipe" },
                "then": [
                    {
                        "id": "base:merge_slot_stack",
                        "args": {
                            "from": {
                                "item": { "$get": "recipe.output" }
                            },
                            "to": { "$get": { "slot": {
                                "block_entity": [ 0, 0, 0 ],
                                "slot": 2
                            } } }
                        },
                        "capture": {
                            "transferred": "merged_count"
                        }
                    },
                    {
                        "if": { "greater_than": [ "merged_count", 0 ] },
                        "then": [
                            { "base:merge_slot_stack": {
                                "from": { "$get": "input_slot" },
                                "to": null,
                                "limit": 1
                            } },
                            { "base:assign_value": {
                                "name": "cook_input_success",
                                "value": true
                            } }
                        ]
                    }
                ]
            }
        ],
        "get_recipe": {
            "base:assign_value": {
                "name": "recipe",
                "ref": { "match_pattern": {
                    "id": "base:recipe/furnace",
                    "query": {
                        "input": { "$get": { "prop": {
                            "value": "input_slot",
                            "path": "stack.item"
                        } } }
                    }
                } }
            }
        },
        "try_burn_fuel": [
            {
                "base:assign_value": {
                    "name": "burn_fuel_success",
                    "value": false
                }
            },
            {
                "base:assign_value": {
                    "name": "fuel_slot",
                    "ref": { "slot": {
                        "block_entity": [ 0, 0, 0 ],
                        "slot": 1
                    } }
                }
            },
            {
                "if": { "item": {
                    "slot": { "$get": "fuel_slot" },
                    "has_tag": "base:fuel"
                } },
                "then": [
                    {
                        "base:merge_slot_stack": {
                            "from": { "$get": "fuel_slot" },
                            "to": null,
                            "limit": 1
                        }
                    },
                    {
                        "base:set_block_entity_data": { "data": {
                            "fuel_time": 300
                        } }
                    },
                    {
                        "base:assign_value": {
                            "name": "burn_fuel_success",
                            "value": true
                        }
                    }
                ]
            }
        ]
    }
}