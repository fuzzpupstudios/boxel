{
    "id": "base:placement/directional",
    
    "triggers": {
        "base:place": [
            {
                "if": {
                    "entity": {
                        "minYaw": -45,
                        "maxYaw": 45
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "north"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 45,
                        "maxYaw": 135
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "east"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 135,
                        "maxYaw": -135
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "south"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": -135,
                        "maxYaw": -45
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "west"
                        }
                    }
                }
            }
        ]
    }
}