{
    "id": "base:placement/stair",
    
    "triggers": {
        "base:place": [
            {
                "if": {
                    "entity": {
                        "minYaw": -45,
                        "maxYaw": 45
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "north"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 45,
                        "maxYaw": 135
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "east"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 135,
                        "maxYaw": -135
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "south"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": -135,
                        "maxYaw": -45
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "direction": "west"
                        }
                    }
                }
            },

            {
                "if": {
                    "face": {
                        "sides": [ "north", "east", "south", "west" ],
                        "minY": 0.5
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "half": "top"
                        }
                    }
                }
            },
            {
                "if": {
                    "face": {
                        "sides": [ "north", "east", "south", "west" ],
                        "maxY": 0.5
                    }
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "half": "bottom"
                        }
                    }
                }
            },

            {
                "if": {
                    "face": "down"
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "half": "top"
                        }
                    }
                }
            },
            {
                "if": {
                    "face": "up"
                },
                "then": {
                    "base:set_block_state_parameter": {
                        "parameters": {
                            "half": "bottom"
                        }
                    }
                }
            }
        ]
    }
}