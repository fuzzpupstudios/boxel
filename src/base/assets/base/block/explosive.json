{
    "id": "base:explosive",
    "states": {
        "default": {
            "model": {
                "include": "base:axis_block",
                "textures": {
                    "side": "base:block/explosive_side.png",
                    "axis": "base:block/explosive_top.png"
                }
            },
            "events": {
                "include": [ "base:material/wood" ],

                "triggers": {
                    "base:destroy": {
                        "if": { "player": { "infiniteItems": false } },
                        "then": { "id": "base:drop_block_item" }
                    },
                    "relay_explode": [
                        { "base:set_block_state_id": {
                            "blockStateId": "base:air[default]"
                        } },
                        { "base:explode": {
                            "radius": 2.7
                        } },
                        { "base:play_sound": {
                            "spatial": true,
                            "sound": {
                                "name": "base:block/explosion",
                                "pitch": [ 0.95, 1 ]
                            }
                        } }
                    ],
                    "base:interact": [
                        "self#relay_explode",
                        { "id": "base:prevent_default" }
                    ],
                    "base:explode": "self#relay_explode"
                }
            },
            "collider": {
                "hitboxes": [
                    { "from": [ 0, 0, 0 ], "to": [ 1, 1, 1 ] }
                ]
            }
        }
    }
}