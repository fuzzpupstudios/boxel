{
    "id": "base:pickaxe",
    "texture": "base:item/pickaxe.png",
    "events": {
        "triggers": {
            "base:item/break_block": {
                "id": "base:set_item_data",
                "args": {
                    "path": "durability",
                    "value": { "$get": { "sum": [
                        { "item_data": "durability" },
                        -1
                    ] } }
                }
            }
        }
    },
    "stackSize": 1,
    "defaultData": {
        "durability": 300,
        "max_durability": 300
    },
    "attributes": {
        "base:mining_speed": {
            "action": "multiply",
            "value": 4,
            "if": { "block": { "has_tag": "base:mineable/pickaxe" } }
        }
    }
}