{
    "id": "base:pickaxe",
    "texture": "base:item/pickaxe.png",
    "events": {
        "triggers": {
            "base:item/break_block": {
                "if": { "player": { "infiniteItems": false } },
                "then": [
                    {
                        "base:set_item_data": {
                            "path": "durability",
                            "value": { "$get": { "sum": [
                                { "item_data": "durability" },
                                -1
                            ] } }
                        }
                    },
                    {
                        "if": { "less_than": [
                            { "item_data": "durability" },
                            0
                        ] },
                        "then": {
                            "base:merge_slot_stack": {
                                "from": { "$get": "$slot" },
                                "to": null,
                                "limit": 1
                            }
                        }
                    }
                ]
            }
        }
    },
    "stackSize": 1,
    "defaultData": {
        "durability": 300,
        "max_durability": 300
    },
    "attributes": {
        "base:mining_speed": {
            "action": "multiply",
            "value": 4,
            "if": { "block": { "has_tag": "base:mineable/pickaxe" } }
        }
    }
}