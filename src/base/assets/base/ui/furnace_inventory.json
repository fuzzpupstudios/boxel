            "fontScale": 2
        },
        "open_inventory": {
            "type": "icon_button",
            "pos": [ 10, 10 ],

            "texture": "base:ui/close_button.png",

            "renderIf": {
                "platform": {
                    "usingTouchscreen": true
                }
            },

            "events": {
                "triggers": {
                    "base:ui/press_down": [
                        {
                            "id": "base:close_gui",
                            "args": {
                                "gui": "base:furnace_inventory"
                            }
                        }
                    ]
                }
            }
        },
        "fuel": {
            "type": "progress",
            "pos": [ 54, 91 ],

            "texture": "base:ui/flame_small.png",
            "direction": "up",

            "events": {
                "triggers": {
                    "base:ui/render": [
                        {
                            "id": "base:set_progress_bar_fill",
                            "args": { "$get": { "quotient": [ 
                                "$block_entity.customData.fuel_time",
                                300
                            ] } }
                        }
                    ]
                }
            }
        },
        "progress": {
            "type": "progress",
            "pos": [ 86, 65 ],

            "texture": "base:ui/furnace_arrow.png",
            "direction": "right",

            "events": {
                "triggers": {
                    "base:ui/render": [
                        {
                            "if": { "equal": [ { "$get": "$block_entity.customData.cook_time" }, -1 ] },
                            "then": {
                                "id": "base:set_progress_bar_fill",
                                "args": 0
                            },
                            "else": {
                                "id": "base:set_progress_bar_fill",
                                "args": { "$get": { "difference": [
                                    1,
                                    { "quotient": [ 
                                        "$block_entity.customData.cook_time",
                                        50
                                    ] }
                                ] } }
                            }
                        }
                    ]
                }
            }
        }
    }
