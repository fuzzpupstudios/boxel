{
    "id": "base:chair",

    "states": {
        "#default": {
            "model": "base:chair",
            "events": {
                "include": [ "base:material/wood", "base:placement/directional" ],

                "triggers": {
                    "relay_drop": {
                        "if": { "player": { "infiniteItems": false } },
                        "then": {
                            "id": "base:drop_item",
                            "args": {
                                "stack": "base:chair[direction=west]"
                            }
                        }
                    },
                    "base:destroy": "self#relay_drop",
                    "base:explode": "self#relay_drop"
                }
            },
            "collider": {
                "hitboxes": [
                    { "from": [ 0.125, 0, 0.125 ], "to": [ 0.875, 0.625, 0.875 ] }
                ]
            },
            "tags": [ "hidden" ],
            "pickBlockState": "direction=west"
        },
        "direction=north": {
            "parent": "#default",
            "model": {
                "transforms": { "rotateY": 2 }
            }
        },
        "direction=east": {
            "parent": "#default",
            "model": {
                "transforms": { "rotateY": 3 }
            }
        },
        "direction=south": {
            "parent": "#default"
        },
        "direction=west": {
            "parent": "#default",
            "model": {
                "transforms": { "rotateY": 1 }
            },
            "tags": [ "^hidden" ]
        }
    }
}