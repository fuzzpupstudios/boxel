{
    "id": "base:chair",

    "defaultStateProperties": {
        "events": {
            "include": [ "base:sound_materials/wood", "base:directional" ],

            "triggers": {
                "relay_drop": {
                    "if": { "player": { "infiniteItems": false } },
                    "then": {
                        "id": "base:drop_item",
                        "args": {
                            "stack": "base:chair[direction=west]"
                        }
                    }
                },
                "base:destroy": {
                    "id": "base:run_trigger",
                    "args": {
                        "triggerName": "relay_drop",
                        "self": true
                    }
                },
                "base:explode": {
                    "id": "base:run_trigger",
                    "args": {
                        "triggerName": "relay_drop",
                        "self": true
                    }
                }
            }
        },
        "collider": {
            "hitboxes": [
                { "from": [ 0.125, 0, 0.125 ], "to": [ 0.875, 0.625, 0.875 ] }
            ]
        },
        "pickBlockState": "direction=west"
    },
    "states": {
        "direction=north": {
            "model": {
                "include": {
                    "model": "base:chair",
                    "transforms": [
                        { "rotateY": 2 }
                    ]
                }
            },
            "tags": [ "hidden" ]
        },
        "direction=east": {
            "model": {
                "include": {
                    "model": "base:chair",
                    "transforms": [
                        { "rotateY": 3 }
                    ]
                }
            },
            "tags": [ "hidden" ]
        },
        "direction=south": {
            "model": {
                "include": "base:chair"
            },
            "tags": [ "hidden" ]
        },
        "direction=west": {
            "model": {
                "include": {
                    "model": "base:chair",
                    "transforms": [
                        { "rotateY": 1 }
                    ]
                }
            }
        }
    }
}