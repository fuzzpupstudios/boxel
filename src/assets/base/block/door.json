                "block": {
                    "at": [ 0, 1, 0 ],
                    "has_tag": "replaceable"
                }
            },
            "events": "base:door_bottom",
            "tags": [ "base:door", "base:door/closed" ],
            "collider": {
                "hitboxes": [
                    { "from": [ 0, 0, 0.875 ], "to": [ 1, 1, 1 ] }
                ]
            }
        },
        "direction=north,open=false,half=top": {
