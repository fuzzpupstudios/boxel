{
    "id": "base:slab",

    "parameters": {
        "texture": "string",
        "id": "string",
        "sound_events": "string"
    },
    "json": {
        "id": "${id}",

        "states": {
            "#default": {
                "events": {
                    "include": [ "base:placement/slab", "${sound_events}" ],

                    "triggers": {
                        "relay_drop": {
                            "if": { "player": { "infiniteItems": false } },
                            "then": {
                                "id": "base:drop_item",
                                "args": {
                                    "stack": "${id}[half=bottom]"
                                }
                            }
                        },
                        "base:destroy": "self#relay_drop",
                        "base:explode": "self#relay_drop"
                    }
                },
                "pickBlockState": "half=bottom"
            },


            "half=bottom": {
                "parent": "#default",
                "model": {
                    "include": "base:slab_bottom",
                    "textures": {
                        "block": "${texture}"
                    }
                },
                "collider": {
                    "hitboxes": [
                        { "from": [ 0, 0, 0 ], "to": [ 1, 0.5, 1 ] }
                    ]
                }
            },
            "half=top": {
                "parent": "#default",
                "model": {
                    "include": "base:slab_top",
                    "textures": {
                        "block": "${texture}"
                    }
                },
                "collider": {
                    "hitboxes": [
                        { "from": [ 0, 0.5, 0 ], "to": [ 1, 1, 1 ] }
                    ]
                },
                "tags": [ "hidden" ]
            }
        }
    }
}