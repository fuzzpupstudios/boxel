{
    "id": "base:slab",

    "parameters": {
        "texture": "string",
        "id": "string",
        "sound_events": "string"
    },
    "json": {
        "id": "${id}",

        "defaultStateProperties": {
            "events": {
                "include": [ "base:slab", "${sound_events}" ],

                "triggers": {
                    "relay_drop": {
                        "if": { "player": { "infiniteItems": false } },
                        "then": {
                            "id": "base:drop_item",
                            "args": {
                                "stack": "${id}[half=bottom]"
                            }
                        }
                    },
                    "base:destroy": {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "relay_drop",
                            "self": true
                        }
                    },
                    "base:explode": {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "relay_drop",
                            "self": true
                        }
                    }
                }
            },
            "pickBlockState": "half=bottom"
        },

        "states": {
            "half=bottom": {
                "model": {
                    "include": "base:slab_bottom",
                    "textures": {
                        "block": "${texture}"
                    }
                },
                "collider": {
                    "hitboxes": [
                        { "from": [ 0, 0, 0 ], "to": [ 1, 0.5, 1 ] }
                    ]
                }
            },
            "half=top": {
                "model": {
                    "include": "base:slab_top",
                    "textures": {
                        "block": "${texture}"
                    }
                },
                "collider": {
                    "hitboxes": [
                        { "from": [ 0, 0.5, 0 ], "to": [ 1, 1, 1 ] }
                    ]
                },
                "tags": [ "hidden" ]
            }
        }
    }
}