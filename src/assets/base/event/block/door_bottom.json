{
    "id": "base:door_bottom",
    
    "triggers": {
        "base:destroy": [
            {
                "if": {
                    "block": {
                        "at": [ 0, 1, 0 ],
                        "has_tag": "base:door"
                    }
                },
                "then": {
                    "id": "base:set_block_state_id",
                    "args": {
                        "yOffset": 1,
                        "blockStateId": "base:air[default]"
                    }
                }
            }
        ],
        "base:place": [
            {
                "if": {
                    "entity": {
                        "minYaw": -45,
                        "maxYaw": 45
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "direction": "north"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 45,
                        "maxYaw": 135
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "direction": "east"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": 135,
                        "maxYaw": -135
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "direction": "south"
                        }
                    }
                }
            },
            {
                "if": {
                    "entity": {
                        "minYaw": -135,
                        "maxYaw": -45
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "direction": "west"
                        }
                    }
                }
            },
            {
                "id": "base:clone_block",
                "args": {
                    "to": [ 0, 1, 0 ]
                }
            },
            {
                "id": "base:set_block_state_parameter",
                "args": {
                    "yOffset": 1,
                    "parameters": {
                        "half": "top"
                    }
                }
            }
        ],
        "base:interact": [
            {
                "if": {
                    "block": {
                        "has_tag": "base:door/open"
                    }
                },
                "then": [
                    {
                        "id": "base:set_block_state_parameter",
                        "args": {
                            "parameters": {
                                "open": "false"
                            }
                        }
                    },
                    {
                        "if": {
                            "block": {
                                "at": [ 0, 1, 0 ],
                                "has_tag": "base:door"
                            }
                        },
                        "then": {
                            "id": "base:set_block_state_parameter",
                            "args": {
                                "yOffset": 1,
                                "parameters": {
                                    "open": "false"
                                }
                            }
                        }
                    }
                ],
                "else": [
                    {
                        "id": "base:set_block_state_parameter",
                        "args": {
                            "parameters": {
                                "open": "true"
                            }
                        }
                    },
                    {
                        "if": {
                            "block": {
                                "at": [ 0, 1, 0 ],
                                "has_tag": "base:door"
                            }
                        },
                        "then": {
                            "id": "base:set_block_state_parameter",
                            "args": {
                                "yOffset": 1,
                                "parameters": {
                                    "open": "true"
                                }
                            }
                        }
                    }
                ]
            },
            {
                "id": "base:prevent_default"
            }
        ]
    }
}