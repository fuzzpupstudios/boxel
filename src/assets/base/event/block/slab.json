{
    "id": "base:slab",
    
    "triggers": {
        "base:place": [
            {
                "if": {
                    "face": {
                        "sides": [ "north", "east", "south", "west" ],
                        "minY": 0.5
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "half": "top"
                        }
                    }
                }
            },
            {
                "if": {
                    "face": {
                        "sides": [ "north", "east", "south", "west" ],
                        "maxY": 0.5
                    }
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "half": "bottom"
                        }
                    }
                }
            },

            {
                "if": {
                    "face": "down"
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "half": "top"
                        }
                    }
                }
            },
            {
                "if": {
                    "face": "up"
                },
                "then": {
                    "id": "base:set_block_state_parameter",
                    "args": {
                        "parameters": {
                            "half": "bottom"
                        }
                    }
                }
            }
        ]
    }
}