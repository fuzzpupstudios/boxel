{
    "id": "base:sound_materials/solid",

    "triggers": {
        "base:place": [
            {
                "id": "base:play_sound",
                "args": {
                    "spatial": true,
                    "sound": {
                        "name": "base:block/place/solid",
                        "pitch": [ 0.95, 1 ]
                    }
                }
            }
        ],
        "base:destroy": [
            {
                "id": "base:play_sound",
                "args": {
                    "spatial": true,
                    "sound": {
                        "name": "base:block/destroy/solid",
                        "pitch": [ 0.95, 1 ]
                    }
                }
            }
        ],
        "base:step": [
            {
                "if": { "usages": { "used": false } },
                "then": {
                    "id": "base:play_sound",
                    "args": {
                        "spatial": true,
                        "useEntityPosition": true,
                        "sound": {
                            "name": "base:block/place/solid",
                            "pitch": [ 1.3, 1.35 ],
                            "volume": 0.5
                        }
                    }
                }
            }
        ],
        "base:fall": [
            {
                "if": { "usages": { "used": false } },
                "then": {
                    "id": "base:play_sound",
                    "args": {
                        "spatial": true,
                        "useEntityPosition": true,
                        "sound": {
                            "name": "base:block/place/solid",
                            "pitch": [ 1.2, 1.25 ],
                            "volume": 1
                        }
                    }
                }
            }
        ]
    }
}