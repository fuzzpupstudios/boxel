{
    "id": "base:door_top",

    "include": "base:door_common",
    
    "triggers": {
        "base:destroy": [
            {
                "if": {
                    "block": {
                        "at": [ 0, -1, 0 ],
                        "has_tag": "base:door"
                    }
                },
                "then": {
                    "id": "base:set_block_state_id",
                    "args": {
                        "yOffset": -1,
                        "blockStateId": "base:air[default]",
                        "showParticles": true
                    }
                }
            }
        ],
        "base:explode": {
            "id": "base:run_trigger",
            "args": {
                "triggerName": "base:destroy",
                "self": true
            }
        },
        "base:interact": [
            {
                "if": {
                    "block": {
                        "has_tag": "base:door/open"
                    }
                },
                "then": [
                    {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "door_close_relay",
                            "self": true
                        }
                    },
                    {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "door_close_relay",
                            "yOffset": -1
                        }
                    }
                ],
                "else": [
                    {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "door_open_relay",
                            "self": true
                        }
                    },
                    {
                        "id": "base:run_trigger",
                        "args": {
                            "triggerName": "door_open_relay",
                            "yOffset": -1
                        }
                    }
                ]
            },
            {
                "id": "base:prevent_default"
            }
        ]
    }
}